# Development-only values. For hosted deployments use a secret manager.
APP_ENV=development
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-unique-secret-before-deploying
DJANGO_ALLOWED_HOSTS=api,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_SECURE_SSL_REDIRECT=false
POSTGRES_DB=synthesift
POSTGRES_USER=synthesift
POSTGRES_PASSWORD=synthesift_local_only
API_PORT=8000
WEB_PORT=3000
LOG_LEVEL=INFO
# Reserved for milestone M3. Not used or sent anywhere in M0.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TEMPERATURE=0.2
GEMINI_TOP_P=0.9
GEMINI_MAX_OUTPUT_TOKENS=2048

# Self-registration is enabled for local development; disable it on public deployments.
SELF_REGISTRATION_ENABLED=true
